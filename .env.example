# TIP: if a value contains the # character, wrap it in quotes: ADMIN_PASSWORD="abc#123"
# (otherwise everything after # is treated as a comment)
# Copy this file to ".env" and fill it in. Never commit ".env".
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=catering_db

# Used only by "npm run seed" the first time (when no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
